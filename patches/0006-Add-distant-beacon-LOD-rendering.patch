+@Mixin(BeaconBlockEntity.class)
+public abstract class MixinBeaconBlockEntity {
+    @Inject(method = "tick", at = @At("TAIL"))
+    private static void voxy$captureResolvedBeam(Level level, BlockPos pos, BlockState state,
